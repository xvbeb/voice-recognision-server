GEMINI_API_KEY=your_api_key
# Audio: specialized Interactions API. Set generate_content for rollback.
GEMINI_TRANSCRIPTION_BACKEND=transcribe
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
# CircleVideo and rollback use the original generateContent model.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=45
