GEMINI_API_KEY=your_api_key
# Audio: specialized Interactions API. Set generate_content for rollback.
GEMINI_TRANSCRIPTION_BACKEND=transcribe
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
# CircleVideo and rollback use the original generateContent model.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=45

# PostgreSQL service reference in Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=
# Owner only. Generate locally: python tools/admin_password.py
ADMIN_PASSWORD_HASH=
# At least 32 random characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_SESSION_SECRET=
ADMIN_ORIGIN=https://voice-recognision-server-production.up.railway.app
